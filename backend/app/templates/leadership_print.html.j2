{% from 'report_analysis.html.j2' import render_analysis %}
{% from 'industrial_chrome.html.j2' import report_brand, metric_icon, section_title, hero, report_heading, executive, kpi %}
{% from 'closing_comparison.html.j2' import closing_range, render_closing_comparison %}
{% set leadership = report.leadership %}
{% set total = leadership.current_month_total %}
{% set day = report.daily_production|default(none) %}
{% set period = report.meta.period_start if report.meta.period_start == report.meta.period_end else report.meta.period_start ~ ' 至 ' ~ report.meta.period_end %}
{% set cover = analysis_cover() %}
{% macro production_table(rows, totals, monthly=false) -%}
<table class="lp-table" aria-label="{{ '月度生产明细' if monthly else '每日生产明细' }}">
  <colgroup><col style="width:6%"><col style="width:22%"><col style="width:10%"><col style="width:22%"><col style="width:20%"><col style="width:20%"></colgroup>
  <thead><tr><th>序号</th><th>{{ '月份' if monthly else '日期' }}</th><th>任务数</th><th>切割长度（米）</th><th>坡口长度（米）</th><th>切割时长</th></tr></thead>
  <tbody>{% for row in rows %}<tr><td>{{ loop.index }}</td><td>{{ row.period_start|chinese_month if monthly else row.period_start|chinese_date }}</td><td>{{ row.task_count }}</td><td>{{ row.cut_length_m|number }}</td><td>{{ row.groove_length_m|number }}</td><td>{{ row.work_time_seconds|duration }}</td></tr>{% endfor %}</tbody>
  <tfoot><tr><th></th><th>汇总</th><th>{{ totals.task_count }}</th><th>{{ totals.cut_length_m|number }}</th><th>{{ totals.groove_length_m|number }}</th><th>{{ totals.work_time_seconds|duration }}</th></tr></tfoot>
</table>
{%- endmacro %}
<div class="leadership-print industrial-document" aria-label="领导报表">
  {{ report_brand(demo_mode) }}
  <section class="lp-sheet lp-overview">
    {{ report_heading(report.meta.title,
      [('grid','设备',device_name), ('calendar','报告周期',period), ('grid','工程号',report.filters.project_code or '全部'), ('grid','船名',report.filters.ship_no or '全部')],
      [('报告编号',report.meta.report_id), ('生成时间',report.meta.generated_at|replace('T',' ')), ('版本',report.meta.system_version)], demo_mode) }}
    {% if summary_shown %}{{ executive(brief.headline, brief.summary) }}{% endif %}

    {% if report.closing_comparison is defined %}
    {{ render_closing_comparison(report.closing_comparison,
      [('task_count','任务数（项）','count'), ('cut_length_m','切割长度（米）','number'),
       ('groove_length_m','坡口长度（米）','number'), ('work_time_seconds','切割工时','duration')],
      title='月、季度、年同期对比') }}
    {% endif %}

    {{ section_title('核心生产指标（业务日）' if report.daily_production is defined else '核心生产指标（本期）') }}
    {% if day %}<div>{{ closing_range(day.start, day.end) }}</div>{% endif %}
    {% if day or report.daily_production is undefined %}
    {% set metrics = day.totals if day else total %}
    <div class="lp-kpis">
      {% for icon,label,value,unit in [('tasks','完成任务',metrics.task_count,'项'),('ruler','切割长度',metrics.cut_length_m|number,'米'),('trend','坡口长度',metrics.groove_length_m|number,'米'),('clock','切割时长',metrics.work_time_seconds|duration,'')] %}
      {{ kpi(icon, label, value, unit) }}
      {% endfor %}
    </div>
    {% else %}
    <p class="empty">所选期间内暂无已截止业务日的生产指标。</p>
    {% endif %}

    {{ section_title('区间每日明细与趋势' if report.meta.custom_period else '当月明细与趋势') }}
    <div class="lp-chart-panel">
      {% if leadership.daily_records %}<div id="lp-daily-chart" class="chart lp-chart"></div>{% else %}<div class="lp-empty">{{ metric_icon('chart') }}<strong>当前区间暂无可视化数据</strong></div>{% endif %}
    </div>
    {% if leadership.daily_records %}<div class="lp-daily-detail">{{ production_table(leadership.daily_records, total) }}</div>{% endif %}
  </section>

  <section class="lp-sheet lp-trends">
    {{ hero('近 12 个月生产趋势', cover) }}
    {% set months = leadership.monthly_records %}
    {% set chronological = months|sort(attribute='period_start') %}
    {% if chronological %}<div>{{ chronological[0].period_start|chinese_month }} 至 {{ chronological[-1].period_start|chinese_month }}</div>{% endif %}
    <div class="lp-chart-panel lp-monthly-panel">{% if months %}<div id="lp-monthly-chart" class="chart lp-chart"></div>{% else %}<div class="lp-empty">{{ metric_icon('chart') }}<strong>近 12 个月暂无月度趋势数据</strong></div>{% endif %}</div>
    {% if months %}
    {% set length_peak = months|sort(attribute='cut_length_m')|last %}
    {% set task_peak = months|sort(attribute='task_count')|last %}
    <div class="lp-month-insights">
      <div>{{ metric_icon('trend') }}<b>切割长度峰值</b><span>{{ length_peak.period_start|chinese_month }}<strong>{{ length_peak.cut_length_m|number }} 米</strong></span></div>
      <div>{{ metric_icon('tasks') }}<b>任务数峰值</b><span>{{ task_peak.period_start|chinese_month }}<strong>{{ task_peak.task_count }} 项</strong></span></div>
    </div>
    {% endif %}
    {{ section_title('月度明细') }}
    {% if months %}<div class="lp-daily-detail">{{ production_table(months, leadership.twelve_month_total, true) }}</div>{% else %}<p class="lp-empty">当前区间暂无已完成任务。</p>{% endif %}
  </section>

  {% if analysis %}{{ render_analysis(analysis, report, report.meta.period_start, report.meta.period_end, summary_shown) }}{% endif %}
  <p class="lp-end">报告结束<span>{{ report.meta.report_id }}</span></p>
</div>
