{% from 'industrial_chrome.html.j2' import metric_icon, hero %}

{% macro render_analysis(analysis, kind, report, line_name, period_start, period_end, title='AI 智能生产洞察') %}
{% set available = analysis and analysis.mode|default('model') == 'model' and analysis.status|default('success') == 'success' %}
{% set brief = analysis.brief if available else none %}
{% set scope = brief.scope if brief else {} %}
{% set facts = analysis.facts|default([]) if analysis else [] %}
{% set quality = brief.data_quality if brief else report.meta.notices|default([]) %}
<section class="lp-sheet lp-analysis" aria-label="智能分析">
  {{ hero(title, 'INTELLIGENCE & DECISION INSIGHTS', analysis_cover()) }}
  <div class="lp-analysis-status"><span>{{ '大模型分析' if available else '未生成分析' }}{{ ' · 已缓存' if analysis and analysis.cached else '' }}</span><span>生成时间：{{ analysis.generated_at or '--' if analysis else '--' }}</span></div>
  <div class="lp-conclusion"><span>{{ metric_icon('trend') }}AI 核心结论</span>
    <h3>{{ brief.headline if brief else '分析结论' if available else '智能分析暂不可用' }}</h3>
    <p>{{ brief.summary if brief else analysis.overview if analysis else '暂无与本次导出数据匹配的分析结果。' }}</p>
    <small>{{ line_name }} · {{ scope.period_start or period_start }} 至 {{ scope.period_end or period_end }}</small>
  </div>

  {% if (brief and brief.findings) or (not brief and analysis and analysis.features) %}
  <section class="lp-analysis-group"><h2>关键发现</h2><div class="lp-analysis-body">
    {% if brief %}{% for finding in brief.findings %}<article class="lp-finding"><h3>{{ finding.title }}</h3><p>{{ finding.detail }}</p>
      {% if finding.references %}<p class="lp-references">关联记录（{{ finding.reference_count }} 项）：{% for reference in finding.references %}{{ reference|analysis_reference_label }}{{ '；' if not loop.last else '' }}{% endfor %}</p>{% endif %}
    </article>{% endfor %}{% else %}<p>{{ analysis.features }}</p>{% endif %}
  </div></section>
  {% endif %}

  {% if facts %}
  <section class="lp-analysis-group"><h2>数据证据 / 分析依据</h2><div class="lp-analysis-body lp-evidence">
    <div class="lp-evidence-primary">{% for fact in facts if fact.id in ['F001', 'F002', 'F003', 'F007'] %}<div><span>{{ fact.label }}</span><strong>{{ fact.value }}</strong></div>{% endfor %}</div>
    {% for fact in facts if fact.id not in ['F001', 'F002', 'F003', 'F007'] %}<div class="lp-evidence-secondary"><span>{{ fact.label }}</span><strong>{{ fact.value }}</strong></div>{% endfor %}
    {% if scope.comparison_start %}<p>比较周期：{{ scope.comparison_start }} 至 {{ scope.comparison_end }}</p>{% endif %}
  </div></section>
  {% endif %}

  {% if quality or (not brief and analysis and analysis.alerts) %}
  <section class="lp-analysis-group lp-quality"><h2>分析边界与待核实事项</h2><div class="lp-analysis-body">
    {% if quality %}<ul>{% for item in quality %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
    {% if not brief and analysis and analysis.alerts %}<p>{{ analysis.alerts }}</p>{% endif %}
  </div></section>
  {% endif %}

  {% if (brief and brief.actions) or (not brief and analysis and analysis.suggestions) %}
  <section class="lp-analysis-group lp-actions"><h2>管理关注建议</h2><div class="lp-analysis-body">
    {% if brief %}{% for action in brief.actions %}<article class="lp-finding"><h3>{{ metric_icon('check') }}{{ action.title }}</h3><p>{{ action.detail }}</p></article>{% endfor %}{% else %}<p>{{ analysis.suggestions }}</p>{% endif %}
  </div></section>
  {% endif %}
</section>
{% endmacro %}
