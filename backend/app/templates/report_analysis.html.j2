{% macro metric_icon(name) -%}
<span class="analysis-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {% if name == 'tasks' %}<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6m-6 4h6m-6 4h6"/>
  {% elif name == 'ruler' %}<path d="M3 8h18v8H3zm4 0v4m5-4v4m5-4v4"/>
  {% elif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/>
  {% elif name == 'grid' %}<path d="M4 4h6v6H4zm10 0h6v6h-6zM4 14h6v6H4zm10 0h6v6h-6z"/>
  {% elif name == 'check' %}<circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/>
  {% elif name == 'wind' %}<path d="M3 8h10a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h6"/>
  {% elif name == 'zap' %}<path d="m13 2-9 12h8l-1 8 9-12h-8Z"/>
  {% else %}<path d="M4 20h16M6 17v-5m6 5V7m6 10V4"/>{% endif %}
</svg></span>
{%- endmacro %}

{% macro render_analysis(analysis, kind, report, line_name, period_start, period_end) %}
{% set brief = analysis.brief %}
{% set scope = brief.scope if brief else {} %}
{% set metrics = analysis_metrics(analysis, kind, report) %}
{% set cover = analysis_cover() %}
<div class="analysis-layout">
  <section class="analysis-banner" aria-label="分析结论"{% if cover %} style="--analysis-cover:url('{{ cover }}')"{% endif %}>
    <p class="analysis-scope">{{ line_name }} · {{ scope.period_start or period_start }} 至 {{ scope.period_end or period_end }}</p>
    <h3>{{ brief.headline if brief else '分析结论' }}</h3>
    <p>{{ brief.summary if brief else analysis.overview }}</p>
  </section>
  {% if metrics %}<section class="analysis-facts" aria-label="关键指标">
    {% for metric in metrics %}<div class="analysis-fact">
      {{ metric_icon(metric.icon) }}<span class="label">{{ metric.label }}</span><strong>{{ metric.value if metric.value is not none else '—' }}</strong>
      {% if metric.note or metric.points %}<div class="analysis-metric-foot">
        {% if metric.note %}<span class="analysis-note">{{ metric.note }} <b class="{{ metric.direction }}">{{ metric.comparison }}</b></span>{% endif %}
        {% if metric.points %}<span class="analysis-sparkline" role="img" aria-label="{{ metric.label }}每日趋势">
          <svg viewBox="0 0 66 23" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <polyline points="{% for x,y in metric.points %}{{ x }},{{ y }} {% endfor %}"/>
          </svg>
        </span>{% endif %}
      </div>{% endif %}
    </div>{% endfor %}
  </section>{% endif %}

  {% if brief %}
    {% set notices = namespace(ongoing='') %}
    {% for item in brief.data_quality if '当前统计周期尚未结束' in item %}{% set notices.ongoing = item %}{% endfor %}
    {% set facts = analysis.facts|selectattr('id','equalto','F004')|list %}
    {% set decline = kind == 'leadership' and facts and (facts[0].value|string).startswith('下降') %}
    {% if brief.findings or notices.ongoing %}
    <h3 class="analysis-subheading">关键发现</h3>
    <div class="analysis-findings">
      {% for finding in brief.findings %}
      <article class="analysis-card{{ ' alerts' if finding.candidate_id == 'C_comparison' and decline else '' }}">
        <h4>{{ finding.title }}</h4><p>{{ finding.detail }}</p>
        {% if finding.references %}<p class="analysis-links">关联记录 {{ finding.reference_count }} 项 · {{ finding.references[:3]|map(attribute='label')|join('、') }}</p>{% endif %}
      </article>
      {% endfor %}
      {% if notices.ongoing %}<article class="analysis-card period"><h4>周期说明 · 周期未结束</h4><p>{{ notices.ongoing }}</p></article>{% endif %}
    </div>
    {% endif %}
    {% if brief.actions %}
    <h3 class="analysis-subheading">建议跟进</h3>
    <div class="analysis-followup">{% for action in brief.actions %}
      <article class="analysis-card suggestions"><h4>{{ action.title }}</h4><p>{{ action.detail }}</p></article>
    {% endfor %}</div>
    {% endif %}
  {% else %}
    {% if analysis.features or analysis.alerts %}
    <h3 class="analysis-subheading">关键发现</h3>
    <div class="analysis-findings">
      {% if analysis.features %}<article class="analysis-card features"><h4>数据特征</h4><p>{{ analysis.features }}</p></article>{% endif %}
      {% if analysis.alerts %}<article class="analysis-card alerts"><h4>需要关注</h4><p>{{ analysis.alerts }}</p></article>{% endif %}
    </div>
    {% endif %}
    {% if analysis.suggestions %}
    <h3 class="analysis-subheading">建议跟进</h3>
    <div class="analysis-followup"><article class="analysis-card suggestions"><p>{{ analysis.suggestions }}</p></article></div>
    {% endif %}
  {% endif %}

  {% set linked = brief.findings|selectattr('references')|list if brief else [] %}
  {% if linked %}
  <details open class="analysis-records"><summary>分析依据 / 关联记录</summary>
    <div class="table-wrap"><table aria-label="分析关联记录">
      <thead><tr><th style="width:21%">关联对象</th><th style="width:13%">记录数</th><th style="width:12%">任务数</th><th style="width:29%">关键数据</th><th>说明</th></tr></thead>
      <tbody>{% for finding in linked %}
        {% set reference = finding.references[0] %}
        {% set projects = report.leadership.project_distribution|default([]) if report.leadership is defined else [] %}
        {% set project = projects|selectattr('project_name','equalto',reference.id)|first if finding.references|length == 1 and reference.kind == 'project' else none %}
        {% set labels = finding.references[:3]|map(attribute='label')|join('、') %}
        {% set tasks = finding.references|selectattr('kind','equalto','task')|list|length %}
        <tr><td title="{{ labels }}">{{ labels }}</td><td>{{ finding.reference_count }} 项</td>
          <td>{{ (project.task_count ~ ' 项') if project else (tasks ~ ' 项') if tasks else '—' }}</td>
          <td>{% if project %}切割长度 {{ project.cut_length_m|number }} 米 · 切割时长 {{ project.work_time_seconds|duration }}{% else %}—{% endif %}</td>
          <td title="{{ finding.title }}">{{ finding.title }}</td></tr>
      {% endfor %}</tbody>
    </table></div>
  </details>
  {% endif %}
  {% set quality = brief.data_quality if brief else report.meta.notices|default([]) %}
  {% if quality or analysis.facts or scope.comparison_start %}
  <details open class="analysis-records">
    <summary>{{ '模型输入与数据说明' if linked else '分析依据' }}</summary>
    <div class="analysis-evidence-list">
      {% if scope.comparison_start %}<p>比较周期：{{ scope.comparison_start }} 至 {{ scope.comparison_end }}</p>{% endif %}
      {% for item in quality %}<p>{{ item }}</p>{% endfor %}
      {% for fact in analysis.facts %}<p>{{ fact.label }}：{{ fact.value }}</p>{% endfor %}
    </div>
  </details>
  {% endif %}
</div>
{% endmacro %}
