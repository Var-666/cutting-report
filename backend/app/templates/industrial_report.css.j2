body.industrial-report { --ink:#071d46; --navy:#053263; --blue:#0057ef; --teal:#00afb8; --line:#c8d9f2; --muted:#5e769c; margin:0; padding:0; color:var(--ink); background:#eaf0fa; font-family:"Microsoft YaHei","PingFang SC","Noto Sans CJK SC",Arial,sans-serif; -webkit-font-smoothing:antialiased; }
.industrial-report * { box-sizing:border-box; }
.industrial-brand { display:flex; align-items:center; gap:12px; min-height:64px; padding:12px 28px; color:#fff; background:linear-gradient(118deg,#022957,#093f78 66%,#032e60); }
.industrial-brand strong { display:block; font-size:18px; letter-spacing:.5px; }.industrial-brand small { display:block; font-size:12px; letter-spacing:.3px; }
.industrial-logo { display:flex; flex-shrink:0; align-items:flex-end; gap:4px; height:32px; transform:skew(-12deg); }.industrial-logo i { display:block; width:6px; height:12px; background:#10ccdf; }.industrial-logo i:nth-child(2){height:20px}.industrial-logo i:nth-child(3){height:32px}
.industrial-brand-tag { margin-left:auto; color:#c6f7ff; font-size:12px; }
.table-wrap,.scroll { max-width:100%; overflow:auto; }
.chart { width:100%; height:42mm; }
.data-chart-grid { display:grid; grid-template-columns:minmax(0,1fr); gap:3mm; }
.content-grid { display:flex; flex-direction:column; gap:3mm; }.content-grid.table_first .chart-card { order:2; }
.chart-card { min-width:0; border:1px solid var(--line); border-radius:2mm; overflow:hidden; }.chart-title { padding:2mm 3mm; color:var(--navy); font-weight:700; background:#eef5ff; }
.secondary { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin-top:3mm; border:1px solid var(--line); border-radius:2mm; background:#eff5ff; }.secondary>div{min-width:0;padding:2mm 3mm;border-right:1px solid var(--line)}.secondary>div:last-child{border:0}.secondary .label{display:block;color:var(--muted);font-size:8pt}
.notice { margin:3mm 0; padding:2mm 3mm; color:#71511d; border-left:3px solid #d68a2f; background:#fff7e8; font-size:9pt; }.notice.error{color:#87353a;border-left-color:#d9555d;background:#fff1f2}
.empty { display:grid; place-items:center; min-height:25mm; padding:6mm; color:var(--muted); text-align:center; background:#f2f6ff; }
.lp-metadata { display:grid; grid-template-columns:90px minmax(0,1fr); gap:1mm 3mm; margin:3mm 0; font-size:8pt; }.lp-metadata dt{color:var(--muted)}.lp-metadata dd{margin:0;overflow-wrap:anywhere}
.sev-critical{color:#b91c1c;font-weight:700}.sev-high{color:#c05621;font-weight:700}.sev-warning{color:#9a6700;font-weight:700}
.report-remark,.print-only { display:none; }
{% include 'leadership_print.css.j2' %}
.leadership-print table { width:100%; min-width:max-content; border-collapse:collapse; white-space:nowrap; font-size:9pt; font-variant-numeric:tabular-nums; }
.leadership-print th,.leadership-print td { height:auto; padding:.6mm 1.5mm; line-height:1.25; text-align:right; border:0; border-bottom:1px solid #e2eafa; white-space:nowrap; }
.leadership-print thead th { position:static; color:#fff; background:linear-gradient(110deg,#155da9,#073d7d); font-size:8pt; font-weight:700; }
.leadership-print th:first-child,.leadership-print td:first-child { text-align:left; }
.leadership-print tbody tr:nth-child(even) { background:#edf3fb; }.leadership-print tbody tr:nth-child(odd) { background:#fff; }
.leadership-print tfoot th { border-top:1px solid #72a6ed; background:#d9eaff; color:#0043bb; font-size:9.5pt; }
.leadership-print tr { break-inside:avoid; }.leadership-print thead{display:table-header-group}
.leadership-print .lp-table { min-width:0; }.leadership-print .lp-table th:first-child,.leadership-print .lp-table td:first-child{text-align:center}
@media screen and (max-width:600px) {
  .industrial-brand{padding:12px;gap:8px}.industrial-brand strong{font-size:15px}.industrial-brand-tag{display:none}
  .secondary{grid-template-columns:1fr}.secondary>div{border:0;border-bottom:1px solid var(--line)}
}
@media print {
  @page { size:auto; margin:0; }
  .industrial-report { background:#fff; }
  .industrial-report .industrial-brand{min-height:16mm;padding:3mm 6mm}.industrial-report .industrial-brand strong{font-size:12pt}.industrial-report .industrial-brand small{font-size:8pt}
  .table-wrap,.scroll { overflow:visible; }
  .leadership-print table { min-width:0; }.leadership-print th,.leadership-print td{overflow-wrap:normal;word-break:normal}
  .industrial-report,.industrial-brand,.leadership-print th{print-color-adjust:exact;-webkit-print-color-adjust:exact}
}
