{% macro report_brand(demo=false) -%}
<div class="industrial-brand">
  <span class="industrial-logo" aria-hidden="true"><i></i><i></i><i></i></span>
  <div><strong>切割生产智能产报系统</strong><small>Production Reporting System</small></div>
  <span class="industrial-brand-tag">{{ '演示数据' if demo else '工业生产智能洞察' }}</span>
</div>
{%- endmacro %}

{% macro metric_icon(name) -%}
<span class="analysis-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {% if name == 'tasks' %}<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6m-6 4h6m-6 4h6"/>
  {% elif name == 'ruler' %}<path d="M3 8h18v8H3zm4 0v4m5-4v4m5-4v4"/>
  {% elif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/>
  {% elif name == 'grid' %}<path d="M4 4h6v6H4zm10 0h6v6h-6zM4 14h6v6H4zm10 0h6v6h-6z"/>
  {% elif name == 'calendar' %}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18"/>
  {% elif name == 'trend' %}<path d="m3 16 6-6 4 4 7-7m-5 0h5v5"/>
  {% elif name == 'alert' %}<path d="M12 4 2.5 20h19L12 4Zm0 6v4m0 3h.01"/>
  {% elif name == 'check' %}<circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/>
  {% elif name == 'wind' %}<path d="M3 8h10a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h6"/>
  {% elif name == 'zap' %}<path d="m13 2-9 12h8l-1 8 9-12h-8Z"/>
  {% else %}<path d="M4 20h16M6 17v-5m6 5V7m6 10V4"/>{% endif %}
</svg></span>
{%- endmacro %}

{% macro section_title(title, english='') -%}
<h2 class="lp-heading"><span>{{ title }}</span>{% if english %}<small>{{ english }}</small>{% endif %}</h2>
{%- endmacro %}

{% macro hero(title, english='AI-POWERED PRODUCTION INTELLIGENCE', cover='') -%}
<div class="lp-hero{{ ' lp-hero--photo' if cover else '' }}"{% if cover %} style="--lp-cover:url('{{ cover }}')"{% endif %}>
  <h1>{{ title }}</h1><p>{{ english }}</p>
</div>
{%- endmacro %}

{% macro report_heading(title, context, folio, demo=false) -%}
{{ hero(title) }}
{% if context %}<div class="lp-context">
  {% for icon,label,value in context %}<div>{{ metric_icon(icon) }}<span>{{ label }}<strong>{{ value }}</strong></span></div>{% endfor %}
</div>{% endif %}
{% if folio %}<div class="lp-folio">{% for label,value in folio %}<span>{{ label }}：{{ value }}</span>{% endfor %}</div>{% endif %}
{% if demo %}<p class="lp-demo">演示数据 · 非生产统计，请勿用于生产决策。</p>{% endif %}
{%- endmacro %}

{% macro executive(title, detail, boundary) -%}
{{ section_title('生产执行摘要', 'EXECUTIVE SUMMARY') }}
<div class="lp-executive">
  <div class="lp-executive-icon">{{ metric_icon('tasks') }}</div>
  <div><h3>{{ title }}</h3><p>{{ detail }}</p>
    <p class="lp-boundary">{{ metric_icon('alert') }}{{ boundary }}</p>
  </div>
</div>
{%- endmacro %}

{% macro kpi(icon, label, value, unit='') -%}
<div class="lp-kpi{{ ' lp-kpi--duration' if icon == 'clock' else '' }}">{{ metric_icon(icon) }}<span>{{ label }}</span><p><strong>{{ value }}</strong>{% if unit %}<small>{{ unit }}</small>{% endif %}</p></div>
{%- endmacro %}
