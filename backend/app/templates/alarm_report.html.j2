{% from 'industrial_chrome.html.j2' import attention_badge, report_brand, report_heading, section_title, hero, executive, kpi %}
{% from 'closing_comparison.html.j2' import render_closing_comparison %}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ machine_no }} 智能告警报告</title>
  <style>{% include 'industrial_report.css.j2' %}</style>
</head>
<body class="industrial-report report-alarm">
<div class="leadership-print industrial-document">
  {{ report_brand(demo_mode|default(false)) }}
  <section class="lp-sheet lp-overview">
    {{ report_heading(machine_no ~ ' 智能告警报告',
      [('alert','风险等级',attention_badge(severity_labels.get(analysis.overall_risk, analysis.overall_risk), analysis.overall_risk)),
       ('calendar','生成时间',generated_at)],
      [('报告编号',report_id)], demo_mode|default(false)) }}
    {{ executive('告警分析结论', analysis.summary) }}
    {% if closing_comparison is defined and closing_comparison is not none %}
    {{ render_closing_comparison(closing_comparison,
      [('incident_count','新增事件（条）','count'), ('critical_count','严重告警（条）','count'), ('high_count','高风险告警（条）','count')]) }}
    {% endif %}
    {{ section_title('核心告警指标（本次分析）') }}
    <div class="lp-kpis">
      {{ kpi('tasks', '关联告警', analysis.facts|length, '条') }}
      {% for severity in ['critical','high','warning'] %}
      {% set count = analysis.facts|selectattr('severity','equalto',severity)|list|length %}
      {{ kpi('alert', severity_labels[severity], count, '条', tone=severity if count else '') }}
      {% endfor %}
    </div>
  </section>
  <section class="lp-sheet lp-analysis" aria-label="智能分析">
    {{ hero('AI 告警分析', cover) }}
    {% if analysis.findings %}
    <section class="lp-analysis-group"><h2>关键发现</h2><div class="lp-analysis-body">
      {% for finding in analysis.findings %}
      <article class="lp-finding">
        <h3>{{ attention_badge(severity_labels.get(finding.severity, finding.severity), finding.severity) }}<span>{{ finding.title }}</span></h3>
        <p>{{ finding.analysis }}</p>
        {% if finding.possible_causes %}<p>可能原因：{{ finding.possible_causes|join('；') }} · 置信度 {{ finding.confidence }}</p>{% endif %}
        {% if finding.evidence_ids %}<p class="lp-references">依据 {{ finding.evidence_ids|join('、') }}</p>{% endif %}
      </article>
      {% endfor %}
    </div></section>
    {% endif %}

    {% if analysis.actions %}
    <section class="lp-analysis-group lp-actions"><h2>管理关注建议</h2><div class="lp-analysis-body">{% for action in analysis.actions %}
      <article class="lp-finding"><h3>优先级 {{ action.priority }}</h3><p>{{ action.action }}</p>
        {% if action.evidence_ids %}<p class="lp-references">依据 {{ action.evidence_ids|join('、') }}</p>{% endif %}
      </article>
    {% endfor %}</div></section>
    {% endif %}

    <section class="lp-analysis-group"><h2>数据证据 / 关联告警</h2><div class="lp-analysis-body">
      <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th style="width:7%">证据</th>
        <th style="width:12%">设备</th>
        <th style="width:9%">级别</th>
        <th style="width:10%">编码</th>
        <th style="width:13%">类别</th>
        <th style="width:25%">描述</th>
        <th style="width:14%">开始时间</th>
        <th style="width:10%">状态</th>
      </tr>
    </thead>
    <tbody>
      {% for fact in analysis.facts %}
      <tr>
        <td>[{{ fact.id }}]</td>
        <td>{{ fact.machine_no }}</td>
        <td>{{ attention_badge(severity_labels.get(fact.severity, fact.severity), fact.severity) }}</td>
        <td>{{ fact.alarm_code }}</td>
        <td>{{ fact.alarm_class }}</td>
        <td title="{{ fact.alarm_desc }}">{{ fact.alarm_desc }}</td>
        <td>{{ fact.start_time }}</td>
        <td>{{ "未解除" if fact.status == "open" else "已解除" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
      </div>
    </div></section>
    {% if analysis.limitations %}
    <section class="lp-analysis-group lp-quality"><h2>分析边界与待核实事项</h2><div class="lp-analysis-body">
      <ul>{% for item in analysis.limitations %}<li>{{ item }}</li>{% endfor %}</ul>
    </div></section>
    {% endif %}
  </section>
  <p class="lp-end">大模型结论仅用于辅助排查，安全处置以现场规程和授权人员判断为准。 · 报告结束<span>{{ report_id }}</span></p>
</div>
{% include 'industrial_report.js.j2' %}
</body>
</html>
