{% macro energy_cell(row, kind) -%}
{% set status = row[kind ~ '_data_status'] %}
{% set value = row[kind ~ '_consumption'] %}
<span title="{{ row.energy_note or '' }}">{{ value|number }}</span>
{% if value is none %}<small class="energy-label">{{ {'missing':'缺边界','gap':'采样断点','counter_reset':'回零/倒退','invalid_reading':'无效读数','unconfigured':'待配置','unmapped':'未绑定','invalid_interval':'时间异常','overlap':'时间重叠','unavailable':'不可用'}.get(status, '缺失') }}</small>{% endif %}
{%- endmacro %}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.meta.title }}</title>
  <style>
    :root { color-scheme:light; --ink:#172234; --muted:#667085; --line:#dfe5ec; --blue:#165d93; --paper:#fff; --bg:#eef2f6; --danger:#b42318; }
    * { box-sizing:border-box; }
    .energy-label { display:block; color:#667085; font-size:10px; }
    body { margin:0; color:var(--ink); background:var(--bg); font:14px/1.55 "Microsoft YaHei","PingFang SC",Arial,sans-serif; }
    .page { width:min(1380px,calc(100% - 32px)); margin:24px auto; background:var(--paper); box-shadow:0 8px 30px rgba(20,40,70,.08); }
    header { padding:32px 38px 24px; color:#fff; background:linear-gradient(120deg,#123d61,#1769aa 62%,#2586bd); }
    h1 { margin:0 0 8px; font-size:28px; letter-spacing:2px; } header p { margin:0; opacity:.88; }
    main { padding:28px 38px 36px; } h2 { margin:32px 0 16px; padding-left:12px; border-left:4px solid var(--blue); font-size:20px; }
    .meta { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; border:1px solid var(--line); background:var(--line); }
    .meta div { padding:11px 14px; background:#fff; }.label { display:block; margin-bottom:3px; color:var(--muted); font-size:12px; }
    .metrics { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }
    .metric { padding:18px; border:1px solid #d8e4ef; border-radius:8px; background:linear-gradient(180deg,#fff,#f7fbfe); }
    .metric strong { display:block; margin-top:4px; color:var(--blue); font-size:25px; font-variant-numeric:tabular-nums; }.metric small { color:var(--muted); }
    .secondary { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-top:12px; }.secondary div { padding:10px 12px; border-radius:6px; background:#f6f8fa; }
    .chart { width:100%; height:300px; border:1px solid var(--line); border-radius:8px; }
    .table-wrap { overflow:auto; border:1px solid var(--line); border-radius:7px; } table { width:100%; border-collapse:collapse; white-space:nowrap; font-variant-numeric:tabular-nums; }
    th,td { height:42px; padding:8px 10px; border-bottom:1px solid var(--line); text-align:right; vertical-align:middle; } th { color:#fff; background:#315b78; font-weight:600; } thead th { position:sticky; top:0; z-index:3; } tfoot th { position:sticky; bottom:0; z-index:2; } th:first-child,td:first-child,th:nth-child(2),td:nth-child(2) { text-align:left; }
    tbody tr:nth-child(even) { background:#f8fafc; } tfoot th { color:#163e5c; background:#eaf2f7; border-top:2px solid #7da4b6; }
    .empty { padding:28px; color:var(--muted); text-align:center; }.notice { margin:12px 0; padding:12px 14px; border-left:4px solid #d79b00; background:#fff8e6; }.notice.error { border-left-color:var(--danger); background:#fff1f0; }
    .analysis-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; }.analysis-mode { display:inline-flex; align-items:center; padding:4px 10px; color:#875700; background:#fff4d6; border:1px solid #f0d58a; border-radius:999px; font-size:12px; }.analysis-mode.model { color:#087443; background:#e9f8f0; border-color:#9cd8b9; }.analysis-facts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-bottom:14px; }.analysis-fact { padding:10px 12px; border:1px solid var(--line); border-radius:7px; background:#f8fafc; }.analysis-fact .fact-id { color:#23849a; font-weight:700; }.analysis-fact strong,.analysis-fact small { display:block; margin-top:2px; }.analysis-fact strong { color:#164f77; }.analysis-fact small { color:#718393; line-height:1.4; }.analysis-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }.analysis-card { padding:16px 18px; border:1px solid var(--line); border-radius:8px; }.analysis-card.wide { grid-column:1/-1; background:#fffaf0; }.analysis-card h3 { margin:0 0 8px; color:var(--blue); }.analysis-card p { margin:0; white-space:pre-wrap; }
    .data-chart-grid { display:grid; grid-template-columns:minmax(360px,.9fr) minmax(0,1.2fr); gap:14px; align-items:start; }.data-chart-grid .table-wrap { height:300px; max-height:300px; }.data-chart-grid table { min-width:760px; table-layout:auto; }.equipment-grid .table-wrap { height:532px; max-height:532px; }.equipment-grid table { min-width:940px; }.chart-stack { display:grid; gap:12px; }.chart-stack .chart { height:260px; }
    .print-tip { margin:0 0 16px; color:var(--muted); text-align:right; } footer { padding:18px 38px; color:var(--muted); border-top:1px solid var(--line); text-align:center; font-size:12px; }
    .print-only { display:none; }
    html.report-printing .data-chart-grid,html.report-printing .data-chart-grid.equipment-grid { display:block!important; }
    html.report-printing .chart-stack { display:block!important; }
    html.report-printing .chart,html.report-printing .chart-stack .chart { width:100%!important; height:58mm!important; margin-bottom:5mm!important; }
    @media (max-width:1000px) { .meta,.metrics { grid-template-columns:repeat(2,1fr); }.secondary,.analysis-grid,.analysis-facts,.data-chart-grid { grid-template-columns:1fr; }.data-chart-grid .table-wrap,.equipment-grid .table-wrap { height:auto; max-height:none; } main,header { padding-left:20px; padding-right:20px; } }
    @media print {
      @page { size:A4 landscape; margin:9mm; }
      html,body { width:auto; min-width:0; background:#fff; font-size:8.5pt; }
      .page { width:100%; margin:0; box-shadow:none; }
      header { padding:10mm 9mm 7mm; }
      header,th { print-color-adjust:exact; -webkit-print-color-adjust:exact; }
      main { padding:7mm 0 5mm; }
      footer { padding:5mm 0 0; }
      .print-tip { display:none; }
      .screen-only { display:none!important; }
      .print-only { display:block!important; }
      .print-table-page { display:block; width:100%; break-before:page; page-break-before:always; break-inside:avoid; page-break-inside:avoid; }
      .print-table-chunk { display:table; width:100%!important; margin:0; table-layout:fixed!important; break-inside:avoid; page-break-inside:avoid; }
      h2 { margin:7mm 0 3.5mm; break-after:avoid-page; page-break-after:avoid; }
      .meta,.metrics,.secondary,.analysis-card,.notice { break-inside:avoid; page-break-inside:avoid; }
      .metric { padding:4mm; }
      .metric strong { font-size:17pt; }
      .data-chart-grid,.data-chart-grid.equipment-grid {
        display:block;
        break-inside:auto;
        page-break-inside:auto;
      }
      .chart-stack { display:block; }
      .chart,.chart-stack .chart {
        width:100%;
        height:58mm;
        margin:0 0 5mm;
        break-inside:avoid;
        page-break-inside:avoid;
      }
      .table-wrap,.data-chart-grid .table-wrap,.equipment-grid .table-wrap {
        width:100%;
        height:auto;
        max-height:none;
        overflow:visible;
        border-radius:0;
        break-inside:auto;
        page-break-inside:auto;
      }
      table,.data-chart-grid table,.equipment-grid table {
        width:100%;
        min-width:0;
        table-layout:fixed;
        white-space:normal;
        font-size:7.5pt;
      }
      thead { display:table-header-group; }
      tbody { display:table-row-group; }
      tfoot { display:table-footer-group; }
      thead th,tfoot th { position:static; }
      tr { break-inside:avoid; page-break-inside:avoid; }
      th,td {
        height:auto;
        padding:2.2mm 1.6mm;
        overflow-wrap:anywhere;
        word-break:break-word;
        vertical-align:top;
      }
      .secondary { grid-template-columns:repeat(3,minmax(0,1fr)); }
      .analysis-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
  </style>
</head>
<body>
<div class="page">
  <header>
    <h1>{{ report.meta.title }}</h1>
    <p>切割生产智能产报系统 · {{ report.meta.report_date[:7] if report.meta.report_type == 'leadership' else report.meta.report_date }}</p>
  </header>
  <main>
    <p class="print-tip">可使用浏览器打印功能输出纸质报告或 PDF</p>
    <section class="meta">
      <div><span class="label">报告类型</span>{{ report.meta.title }}</div>
      <div><span class="label">报告周期</span>{{ report.meta.report_date[:7] if report.meta.report_type == 'leadership' else report.meta.report_date }}</div>
      <div><span class="label">生成时间</span>{{ report.meta.generated_at }}</div>
      <div><span class="label">报告编号</span>{{ report.meta.report_id }}</div>
      <div><span class="label">工程号</span>{{ report.filters.project_code or '全部' }}</div>
      <div><span class="label">船号</span>{{ report.filters.ship_no or '全部' }}</div>
      <div><span class="label">数据更新时间</span>{{ report.meta.data_updated_at or '--' }}</div>
      <div><span class="label">系统版本</span>{{ report.meta.system_version }}</div>
    </section>

    {% if report.meta.report_type == 'leadership' %}
    <h2>一、当月汇总</h2>
    <section class="metrics">
      <div class="metric"><small>完成任务</small><strong>{{ report.leadership.current_month_total.task_count }}</strong><small>项</small></div>
      <div class="metric"><small>切割长度</small><strong>{{ report.leadership.current_month_total.cut_length_m|number }}</strong><small>米</small></div>
      <div class="metric"><small>坡口长度</small><strong>{{ report.leadership.current_month_total.groove_length_m|number }}</strong><small>米</small></div>
      <div class="metric"><small>切割时长</small><strong>{{ report.leadership.current_month_total.work_time_seconds|duration }}</strong><small>HH:mm:ss</small></div>
    </section>

    <h2>二、当月明细与趋势</h2>
    <p class="section-note">统计口径：STATUS = 2 且 WORK_TIME ≥ 0；负工时异常任务整条剔除。</p>
    <div class="data-chart-grid">
      {% if report.leadership.daily_records %}<div id="leadership-daily-chart" class="chart"></div>{% else %}<div class="empty">当前月份暂无可视化数据。</div>{% endif %}
      <div class="table-wrap">
      {% if report.leadership.daily_records %}
      <table><colgroup><col style="width:4%"><col style="width:16%"><col style="width:8%"><col style="width:16%"><col style="width:16%"><col style="width:15%"><col style="width:25%"></colgroup><thead><tr><th>序号</th><th>日期</th><th>任务数</th><th>切割长度（米）</th><th>坡口长度（米）</th><th>切割时长</th><th>备注</th></tr></thead>
      <tbody>{% for row in report.leadership.daily_records %}<tr><td>{{ loop.index }}</td><td>{{ row.period_start }}</td><td>{{ row.task_count }}</td><td>{{ row.cut_length_m|number }}</td><td>{{ row.groove_length_m|number }}</td><td>{{ row.work_time_seconds|duration }}</td><td>{{ row.remark or '--' }}</td></tr>{% endfor %}</tbody>
      <tfoot><tr><th></th><th>汇总</th><th>{{ report.leadership.current_month_total.task_count }}</th><th>{{ report.leadership.current_month_total.cut_length_m|number }}</th><th>{{ report.leadership.current_month_total.groove_length_m|number }}</th><th>{{ report.leadership.current_month_total.work_time_seconds|duration }}</th><th>--</th></tr></tfoot></table>
      {% else %}<div class="empty">所选月份暂无已完成任务。</div>{% endif %}
      </div>
    </div>

    <h2>三、历月对比与趋势</h2>
    <div class="data-chart-grid">
      {% if report.leadership.monthly_records %}<div id="leadership-monthly-chart" class="chart"></div>{% else %}<div class="empty">最近十二个月暂无趋势数据。</div>{% endif %}
      <div class="table-wrap">
      {% if report.leadership.monthly_records %}
      <table><colgroup><col style="width:4%"><col style="width:16%"><col style="width:8%"><col style="width:16%"><col style="width:16%"><col style="width:15%"><col style="width:25%"></colgroup><thead><tr><th>序号</th><th>月份</th><th>任务数</th><th>切割长度（米）</th><th>坡口长度（米）</th><th>切割时长</th><th>备注</th></tr></thead>
      <tbody>{% for row in report.leadership.monthly_records %}<tr><td>{{ loop.index }}</td><td>{{ row.period_start[:7] }}</td><td>{{ row.task_count }}</td><td>{{ row.cut_length_m|number }}</td><td>{{ row.groove_length_m|number }}</td><td>{{ row.work_time_seconds|duration }}</td><td>{{ row.remark or '--' }}</td></tr>{% endfor %}</tbody>
      <tfoot><tr><th></th><th>汇总</th><th>{{ report.leadership.twelve_month_total.task_count }}</th><th>{{ report.leadership.twelve_month_total.cut_length_m|number }}</th><th>{{ report.leadership.twelve_month_total.groove_length_m|number }}</th><th>{{ report.leadership.twelve_month_total.work_time_seconds|duration }}</th><th>--</th></tr></tfoot></table>
      {% else %}<div class="empty">最近十二个月暂无已完成任务。</div>{% endif %}
      </div>
    </div>

    {% elif report.meta.report_type == 'workshop' %}
    <h2>一、车间生产指标</h2>
    <section class="metrics">
      <div class="metric"><small>任务数量</small><strong>{{ report.summary.task_count }}</strong><small>项</small></div>
      <div class="metric"><small>总切割长度</small><strong>{{ report.summary.total_cut_length|number }}</strong><small>米</small></div>
      <div class="metric"><small>总坡口长度</small><strong>{{ report.summary.total_groove_length|number }}</strong><small>米</small></div>
      <div class="metric"><small>总切割时长</small><strong>{{ report.summary.total_work_time|duration }}</strong><small>HH:mm:ss</small></div>
    </section>
    <section class="secondary">
      <div><span class="label">平均切割长度</span>{{ report.summary.avg_cut_length|number }} 米</div>
      <div><span class="label">平均坡口长度</span>{{ report.summary.avg_groove_length|number }} 米</div>
      <div><span class="label">平均切割时长</span>{{ report.summary.avg_work_time|duration }}</div>
    </section>

    {% if report.data_quality %}<h2>二、数据质量提示</h2>{% for item in report.data_quality %}<div class="notice {{ 'error' if item.level == 'error' else '' }}">{{ item.task_id or '未定位任务' }}：{{ item.message }}</div>{% endfor %}{% endif %}
    <h2>三、车间生产明细与图表</h2>
    <div class="data-chart-grid">
      {% if report.summary.task_count %}<div id="length-chart" class="chart"></div>{% else %}<div class="empty">当前条件下暂无可视化数据。</div>{% endif %}
      <div class="table-wrap">
      {% if report.workshop_records %}<table class="screen-only"><colgroup><col style="width:3%"><col style="width:6%"><col style="width:7%"><col style="width:7%"><col style="width:6%"><col style="width:15%"><col style="width:8%"><col style="width:8%"><col style="width:8%"><col style="width:12%"><col style="width:10%"><col style="width:10%"></colgroup><thead><tr><th>序号</th><th>任务ID</th><th>工程号</th><th>船号</th><th>分段</th><th>程序号</th><th>切割长度（米）</th><th>坡口长度（米）</th><th>切割时长</th><th>时间</th><th>人</th><th>备注</th></tr></thead>
      <tbody>{% for row in report.workshop_records %}<tr><td>{{ loop.index }}</td><td>{{ row.task_id }}</td><td>{{ row.project_code or '--' }}</td><td>{{ row.ship_no or '--' }}</td><td>{{ row.segment_name or '--' }}</td><td>{{ row.program_no or '--' }}</td><td>{{ row.cut_length|number }}</td><td>{{ row.groove_length|number }}</td><td>{{ row.work_time|duration }}</td><td>{{ row.production_time[:16]|replace('T',' ') if row.production_time else '--' }}</td><td>{{ '✓ ' ~ row.confirmed_by if row.confirmed_by else '未确认' }}</td><td>{{ row.remark or '--' }}</td></tr>{% endfor %}</tbody></table>
      <div class="print-only">{% for chunk in report.workshop_records|batch(14) %}{% set chunk_index = loop.index0 %}<section class="print-table-page"><table class="print-table-chunk"><colgroup><col style="width:3%"><col style="width:6%"><col style="width:7%"><col style="width:7%"><col style="width:6%"><col style="width:15%"><col style="width:8%"><col style="width:8%"><col style="width:8%"><col style="width:12%"><col style="width:10%"><col style="width:10%"></colgroup><thead><tr><th>序号</th><th>任务ID</th><th>工程号</th><th>船号</th><th>分段</th><th>程序号</th><th>切割长度（米）</th><th>坡口长度（米）</th><th>切割时长</th><th>时间</th><th>人</th><th>备注</th></tr></thead><tbody>{% for row in chunk %}<tr><td>{{ chunk_index * 14 + loop.index }}</td><td>{{ row.task_id }}</td><td>{{ row.project_code or '--' }}</td><td>{{ row.ship_no or '--' }}</td><td>{{ row.segment_name or '--' }}</td><td>{{ row.program_no or '--' }}</td><td>{{ row.cut_length|number }}</td><td>{{ row.groove_length|number }}</td><td>{{ row.work_time|duration }}</td><td>{{ row.production_time[:16]|replace('T',' ') if row.production_time else '--' }}</td><td>{{ '✓ ' ~ row.confirmed_by if row.confirmed_by else '未确认' }}</td><td>{{ row.remark or '--' }}</td></tr>{% endfor %}</tbody></table></section>{% endfor %}</div>
      {% else %}<div class="empty">当前条件下暂无车间生产数据。</div>{% endif %}
      </div>
    </div>
    {% else %}
    <h2>一、设备能耗指标</h2>
    <section class="metrics">
      <div class="metric"><small>任务数量</small><strong>{{ report.equipment_summary.task_count }}</strong><small>项</small></div>
      <div class="metric"><small>切割时长</small><strong>{{ report.equipment_summary.total_work_time|duration }}</strong><small>HH:mm:ss</small></div>
      <div class="metric"><small>任务气耗合计</small><strong>{{ report.equipment_summary.total_gas_consumption|number }}</strong><small>{{ report.units.gas }} · 已匹配 {{ report.equipment_summary.gas_record_count }}/{{ report.equipment_summary.task_count }} 项</small></div>
      <div class="metric"><small>任务电耗合计</small><strong>{{ report.equipment_summary.total_electricity_consumption|number }}</strong><small>{{ report.units.electricity }} · 已匹配 {{ report.equipment_summary.electricity_record_count }}/{{ report.equipment_summary.task_count }} 项</small></div>
    </section>
    <h2>二、当日任务能耗明细</h2>
    <div class="notice">{{ report.energy_notice }} 其中插值估算 {{ report.equipment_summary.estimated_record_count }} 项；缺失不等于零。</div>
    <div class="data-chart-grid equipment-grid">
      {% if report.equipment_records %}<div id="equipment-detail-chart" class="chart"></div>{% else %}<div class="empty">所选日期暂无任务。</div>{% endif %}
      <div class="table-wrap">
      {% if report.equipment_records %}<table class="screen-only"><thead><tr><th>序号</th><th>工程号</th><th>船号</th><th>分段名</th><th>任务开始</th><th>切割时长</th><th>电耗（{{ report.units.electricity }}）</th><th>气耗（{{ report.units.gas }}）</th></tr></thead>
      <tbody>{% for row in report.equipment_records %}<tr><td>{{ loop.index }}</td><td>{{ row.project_code or '--' }}</td><td>{{ row.ship_no or '--' }}</td><td>{{ row.segment_name or '--' }}</td><td>{{ row.production_time[:19]|replace('T',' ') if row.production_time else '--' }}</td><td>{{ row.work_time|duration }}</td><td>{{ row.electricity_consumption|number }}</td><td>{{ row.gas_consumption|number }}</td></tr>{% endfor %}</tbody>
      <tfoot><tr><th colspan="5">当日任务汇总（{{ report.equipment_summary.task_count }} 项）</th><th>{{ report.equipment_summary.total_work_time|duration }}</th><th>{{ report.equipment_summary.total_electricity_consumption|number }}</th><th>{{ report.equipment_summary.total_gas_consumption|number }}</th></tr></tfoot></table>
      <div class="print-only">{% for chunk in report.equipment_records|batch(14) %}{% set chunk_index = loop.index0 %}<section class="print-table-page"><table class="print-table-chunk"><thead><tr><th>序号</th><th>工程号</th><th>船号</th><th>分段名</th><th>任务开始</th><th>切割时长</th><th>电耗</th><th>气耗</th></tr></thead><tbody>{% for row in chunk %}<tr><td>{{ chunk_index * 14 + loop.index }}</td><td>{{ row.project_code or '--' }}</td><td>{{ row.ship_no or '--' }}</td><td>{{ row.segment_name or '--' }}</td><td>{{ row.production_time[:19]|replace('T',' ') if row.production_time else '--' }}</td><td>{{ row.work_time|duration }}</td><td>{{ row.electricity_consumption|number }}</td><td>{{ row.gas_consumption|number }}</td></tr>{% endfor %}</tbody></table></section>{% endfor %}</div>
      {% else %}<div class="empty">所选日期暂无任务。</div>{% endif %}
      </div>
    </div>

    <h2>三、月度每日能耗汇总</h2>
    <p class="section-note">统计月份：{{ report.energy_month.report_month }}；未查询或缺失日期不按零处理。</p>
    <div class="data-chart-grid">
      <div id="equipment-month-chart" class="chart"></div>
      <div class="table-wrap">
        <table class="screen-only"><thead><tr><th>日期</th><th>电耗（{{ report.units.electricity }}）</th><th>电耗覆盖</th><th>气耗（{{ report.units.gas }}）</th><th>气耗覆盖</th><th>保存状态</th></tr></thead>
        <tbody>{% for row in report.energy_month.rows %}<tr><td>{{ row.report_date }}</td><td>{{ row.electricity.value|number }}</td><td>{{ row.electricity.label }} · {{ row.electricity.valid_count or 0 }}/{{ row.electricity.expected_count or 0 }} 小时</td><td>{{ row.gas.value|number }}</td><td>{{ row.gas.label }} · {{ row.gas.valid_count or 0 }}/{{ row.gas.expected_count or 0 }} 小时</td><td>{{ '日期未到' if row.is_future else '已保存' if row.saved else '尚未查询' }}</td></tr>{% endfor %}</tbody>
        <tfoot><tr><th>当月汇总</th><th>{{ report.energy_month.summary.electricity.value|number }}</th><th>{{ report.energy_month.summary.electricity.label }} · {{ report.energy_month.summary.electricity.valid_count or 0 }}/{{ report.energy_month.summary.electricity.expected_count or 0 }} 天</th><th>{{ report.energy_month.summary.gas.value|number }}</th><th>{{ report.energy_month.summary.gas.label }} · {{ report.energy_month.summary.gas.valid_count or 0 }}/{{ report.energy_month.summary.gas.expected_count or 0 }} 天</th><th>{{ report.energy_month.saved_day_count }} 天已保存</th></tr></tfoot></table>
        <div class="print-only">{% for chunk in report.energy_month.rows|batch(18) %}<section class="print-table-page"><table class="print-table-chunk"><thead><tr><th>日期</th><th>电耗（{{ report.units.electricity }}）</th><th>电耗覆盖</th><th>气耗（{{ report.units.gas }}）</th><th>气耗覆盖</th><th>保存状态</th></tr></thead><tbody>{% for row in chunk %}<tr><td>{{ row.report_date }}</td><td>{{ row.electricity.value|number }}</td><td>{{ row.electricity.label }} · {{ row.electricity.valid_count or 0 }}/{{ row.electricity.expected_count or 0 }} 小时</td><td>{{ row.gas.value|number }}</td><td>{{ row.gas.label }} · {{ row.gas.valid_count or 0 }}/{{ row.gas.expected_count or 0 }} 小时</td><td>{{ '日期未到' if row.is_future else '已保存' if row.saved else '尚未查询' }}</td></tr>{% endfor %}</tbody></table></section>{% endfor %}</div>
      </div>
    </div>
    {% endif %}

    {% if report.analysis %}
    <h2>{{ '四' if report.meta.report_type in ['leadership', 'workshop', 'equipment'] else '三' }}、智能分析</h2>
    <div class="analysis-head">
      <span class="analysis-mode {{ 'model' if report.analysis.mode == 'model' else '' }}">{{ '大模型分析' if report.analysis.mode == 'model' else '模拟大模型分析' }}</span>
      <span class="label">生成时间：{{ report.analysis.generated_at or '--' }}{{ '· 已使用缓存' if report.analysis.cached else '' }}</span>
    </div>
    {% if report.analysis.facts %}<section class="analysis-facts">{% for fact in report.analysis.facts %}<div class="analysis-fact"><span class="fact-id">{{ fact.id }}</span><span class="label"> · {{ fact.label }}</span><strong>{{ fact.value }}</strong><small>来源：{{ fact.source or '当前报表数据' }}</small></div>{% endfor %}</section>{% endif %}
    <section class="analysis-grid">
      <article class="analysis-card"><h3>生产概况</h3><p>{{ report.analysis.overview }}</p></article>
      <article class="analysis-card"><h3>数据特征</h3><p>{{ report.analysis.features }}</p></article>
      <article class="analysis-card"><h3>异常与关注点</h3><p>{{ report.analysis.alerts }}</p></article>
      <article class="analysis-card"><h3>生产管理建议</h3><p>{{ report.analysis.suggestions }}</p></article>
      {% if report.analysis.limitations %}<article class="analysis-card wide"><h3>分析边界</h3><p>{{ report.analysis.limitations }}</p></article>{% endif %}
    </section>
    {% endif %}
  </main>
  <footer>本报告由切割生产智能产报系统生成 · 报告结束</footer>
</div>
<script>{{ echarts_source|safe }}</script>
<script>
  const charts = [];
  {% if report.meta.report_type == 'leadership' %}
  {% if report.leadership.daily_records %}
  const dailyTrendChart = echarts.init(document.getElementById('leadership-daily-chart'));
  dailyTrendChart.setOption({{ report.charts.daily_trend|tojson }}); charts.push(dailyTrendChart);
  {% endif %}
  {% if report.leadership.monthly_records %}
  const monthlyTrendChart = echarts.init(document.getElementById('leadership-monthly-chart'));
  monthlyTrendChart.setOption({{ report.charts.monthly_trend|tojson }}); charts.push(monthlyTrendChart);
  {% endif %}
  {% elif report.meta.report_type == 'workshop' and report.summary.task_count %}
  const lengthChart = echarts.init(document.getElementById('length-chart'));
  lengthChart.setOption({{ report.charts.length_combo|tojson }}); charts.push(lengthChart);
  {% elif report.meta.report_type == 'equipment' %}
  {% if report.equipment_records %}
  const equipmentDetailChart = echarts.init(document.getElementById('equipment-detail-chart'));
  equipmentDetailChart.setOption({{ report.charts.equipment_detail|tojson }}); charts.push(equipmentDetailChart);
  {% endif %}
  const equipmentMonthChart = echarts.init(document.getElementById('equipment-month-chart'));
  equipmentMonthChart.setOption({{ report.charts.equipment_month|tojson }}); charts.push(equipmentMonthChart);
  {% endif %}
  const resizeCharts = () => charts.forEach(chart => chart.resize());
  const preparePrint = () => {
    document.documentElement.classList.add('report-printing');
    void document.body.offsetWidth;
    charts.forEach(chart => {
      chart.resize();
      chart.setOption({ animation: false }, false);
    });
  };
  const restoreScreen = () => {
    document.documentElement.classList.remove('report-printing');
    requestAnimationFrame(resizeCharts);
  };
  window.addEventListener('resize', resizeCharts);
  window.addEventListener('beforeprint', preparePrint);
  window.addEventListener('afterprint', restoreScreen);
  const printMedia = window.matchMedia('print');
  if (printMedia.addEventListener) printMedia.addEventListener('change', event => {
    if (event.matches) preparePrint();
    else restoreScreen();
  });
  charts.forEach(chart => chart.setOption({ animation: false }, false));
  Promise.resolve(document.fonts?.ready).then(() => requestAnimationFrame(() => requestAnimationFrame(() => {
    resizeCharts();
    document.documentElement.dataset.reportReady = 'true';
    window.__REPORT_READY__ = true;
  })));
</script>
</body>
</html>
