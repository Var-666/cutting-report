{% from 'report_analysis.html.j2' import render_analysis %}
{% from 'industrial_chrome.html.j2' import attention_badge, report_brand, report_heading, section_title, executive, kpi %}
{% from 'closing_comparison.html.j2' import render_closing_comparison %}
{% macro task_label(value) -%}
  {{ (value or '')|trim or attention_badge('未知', 'critical') }}
{%- endmacro %}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.meta.title }}</title>
  <style>{% include 'industrial_report.css.j2' %}</style>
</head>
<body class="industrial-report report-{{ report.meta.report_type }}">
{% set analysis = report.analysis %}
{% set brief = analysis.brief if analysis else none %}
{% set summary_shown = brief and not analysis.cache_note and analysis.mode|default('model') == 'model' and analysis.status|default('success') == 'success' %}
{% if report.meta.report_type == 'leadership' %}
  {% include 'leadership_print.html.j2' %}
{% else %}
<div class="leadership-print industrial-document">
  {{ report_brand(demo_mode) }}
  <section class="lp-sheet lp-overview">
    {% set period = report.meta.period_start if report.meta.period_start == report.meta.period_end else report.meta.period_start ~ ' 至 ' ~ report.meta.period_end %}
    {{ report_heading(report.meta.title,
      [('grid','设备',device_name), ('calendar','报告周期',period), ('grid','工程号',report.filters.project_code or '全部'), ('grid','船名',report.filters.ship_no or '全部')],
      [('报告编号',report.meta.report_id), ('生成时间',report.meta.generated_at|replace('T',' ')), ('版本',report.meta.system_version)], demo_mode) }}
    <p class="lp-method">数据更新时间：{{ report.meta.data_updated_at or '--' }} · {{ '自定义区间' if report.meta.custom_period else '标准报告周期' }}</p>
    {% set day = report.closing_comparison[0] if report.closing_comparison else none %}
    {% if summary_shown %}{{ executive(brief.headline, brief.summary) }}{% endif %}
    {% if report.closing_comparison is defined %}
      {% if report.meta.report_type == 'workshop' %}
      {{ render_closing_comparison(report.closing_comparison,
        [('task_count','任务数（项）','count'), ('cut_length_m','切割长度（米）','number'),
         ('groove_length_m','坡口长度（米）','number'), ('work_time_seconds','切割工时','duration')],
        '按实际完工时间归属', '累计和同期均应用本报表的设备、工程号及船名筛选。') }}
      {% else %}
      {{ render_closing_comparison(report.closing_comparison,
        [('task_count','设备任务数（项）','count'), ('work_time_seconds','切割工时','duration'),
         ('electricity','仪表电耗（' ~ report.units.electricity ~ '）','number'),
         ('gas','仪表气耗（' ~ report.units.gas ~ '）','number')],
        '设备任务按实际完工时间归属',
        '仪表能耗累计已保存的有效小时，含待机时段。覆盖不足时标出有效小时数和应覆盖小时数，仅在可比区间完整时计算能耗变化率。') }}
      {% endif %}
    {% endif %}
    {% if report.meta.report_type == 'workshop' %}
    {{ section_title('核心生产指标（' ~ (day.label if day else '本期') ~ '）') }}
    {% if day or report.closing_comparison is undefined %}
    {% set summary = day.totals if day else report.summary %}
    {% set cut_length = summary.cut_length_m if day else summary.total_cut_length %}
    {% set groove_length = summary.groove_length_m if day else summary.total_groove_length %}
    {% set work_time = summary.work_time_seconds if day else summary.total_work_time %}
    {% set count = summary.task_count %}
    {% set average_cut = (cut_length / count if count else none) if day else summary.avg_cut_length %}
    {% set average_groove = (groove_length / count if count else none) if day else summary.avg_groove_length %}
    {% set average_work_time = (work_time / count if count else none) if day else summary.avg_work_time %}
    <div class="lp-kpis">
      {{ kpi('tasks', '任务数量', summary.task_count, '项') }}
      {{ kpi('ruler', '切割长度', cut_length|number, '米') }}
      {{ kpi('trend', '坡口长度', groove_length|number, '米') }}
      {{ kpi('clock', '切割时长', work_time|duration) }}
    </div>
    <section class="secondary">
      <div><span class="label">平均切割长度</span>{{ average_cut|number }} 米</div>
      <div><span class="label">平均坡口长度</span>{{ average_groove|number }} 米</div>
      <div><span class="label">平均切割时长</span>{{ average_work_time|duration }}</div>
    </section>
    {% else %}
    <p class="empty">所选期间内暂无已截止业务日的生产指标。</p>
    {% endif %}

    {{ section_title('车间生产明细与趋势') }}
    <p class="lp-method">明细与趋势按报告周期展示。切割记录与工人确认分别统计，待确认任务仍计入已完成的切割任务。</p>
    <div class="data-chart-grid">
      {% if report.summary.task_count %}<div id="length-chart" class="chart"></div>{% else %}<div class="empty">当前条件下暂无可视化数据。</div>{% endif %}
      <div class="table-wrap">
      {% if report.workshop_records %}<table class="screen-only"><colgroup><col style="width:3%"><col style="width:6%"><col style="width:7%"><col style="width:7%"><col style="width:6%"><col style="width:15%"><col style="width:8%"><col style="width:8%"><col style="width:8%"><col style="width:12%"><col style="width:10%"><col class="report-remark" style="width:10%"></colgroup><thead><tr><th>序号</th><th>任务ID</th><th>工程号</th><th>船名</th><th>分段</th><th>程序号</th><th>切割长度（米）</th><th>坡口长度（米）</th><th>切割时长</th><th>时间</th><th>待确认</th><th class="report-remark">备注</th></tr></thead>
      <tbody>{% for row in report.workshop_records %}<tr><td>{{ loop.index }}</td><td>{{ row.task_id }}</td><td>{{ task_label(row.project_code) }}</td><td>{{ task_label(row.ship_no) }}</td><td>{{ task_label(row.segment_name) }}</td><td>{{ row.program_no or '--' }}</td><td>{{ row.cut_length|number }}</td><td>{{ row.groove_length|number }}</td><td>{{ row.work_time|duration }}</td><td>{{ row.production_time|chinese_datetime }}</td><td>{{ '✓ ' ~ row.confirmed_by if row.confirmed_by else '待确认' }}</td><td class="report-remark">{{ row.remark or '--' }}</td></tr>{% endfor %}</tbody></table>
      {% else %}<div class="empty">当前条件下暂无车间生产数据。</div>{% endif %}
      </div>
    </div>
    {% if report.worker_summaries %}{{ section_title('工人工时汇总') }}<div class="table-wrap"><table><thead><tr><th>序号</th><th>工号</th><th>姓名</th><th>已确认任务</th><th>切割长度（米）</th><th>切割时长</th><th>工时占比</th><th>最后确认时间</th></tr></thead><tbody>{% for worker in report.worker_summaries %}<tr><td>{{ loop.index }}</td><td>{{ worker.company_no or '--' }}</td><td>{{ worker.worker_name }}</td><td>{{ worker.confirmed_task_count }}</td><td>{{ worker.total_cut_length|number }}</td><td>{{ worker.total_work_time_seconds|duration }}</td><td>{{ worker.work_time_share|number }}%</td><td>{{ worker.last_confirmed_at|chinese_datetime }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
    {% else %}
    {{ section_title('核心生产指标（' ~ (day.label if day else '本期') ~ '）') }}
    {% if not energy_connected %}<p class="notice lp-tone-warning"><strong>能耗暂未接入</strong> · 电耗与气耗暂无数据。</p>{% endif %}
    {% if day %}
    <div class="lp-kpis">
      {{ kpi('tasks', '任务数量', day.totals.task_count, '项') }}
      {{ kpi('clock', '切割时长', day.totals.work_time_seconds|duration) }}
      {% for icon, channel, label in [('wind', 'gas', '仪表气耗'), ('zap', 'electricity', '仪表电耗')] %}
      {% set meter = day.meter_coverage[channel] %}
      {{ kpi(icon, label, '—' if meter.value is none else meter.value|number, report.units[channel]) }}
      {% endfor %}
    </div>
    {% elif report.closing_comparison is defined %}
    <p class="empty">所选期间内暂无已截止业务日的生产指标。</p>
    {% else %}
    <div class="lp-kpis">
      {{ kpi('tasks', '任务数量', report.equipment_summary.task_count, '项') }}
      {{ kpi('clock', '切割时长', report.equipment_summary.total_work_time|duration) }}
      {{ kpi('wind', '任务气耗合计', report.equipment_summary.total_gas_consumption|number, report.units.gas) }}
      {{ kpi('zap', '任务电耗合计', report.equipment_summary.total_electricity_consumption|number, report.units.electricity) }}
    </div>
    {% endif %}
    {{ section_title('区间任务能耗明细' if report.meta.custom_period else '当日任务能耗明细') }}
    <p class="lp-method">
      {% set task_count = report.equipment_summary.task_count %}
      {% for channel, matched in [('气耗', report.equipment_summary.gas_record_count), ('电耗', report.equipment_summary.electricity_record_count)] %}
      {{ channel }}已匹配 {{ matched }}/{{ task_count }} 项{% if energy_connected and matched < task_count %} {{ attention_badge('匹配不全') }}{% endif %}{{ '；' if not loop.last else '。' }}
      {% endfor %}
      缺失能耗不作零。累计作业工时不等于设备开机时间。
    </p>
    <div class="data-chart-grid equipment-grid">
      {% if report.equipment_records %}<div id="equipment-detail-chart" class="chart"></div>{% else %}<div class="empty">所选区间暂无任务。</div>{% endif %}
      <div class="table-wrap">
      {% if report.equipment_records %}<table class="screen-only"><thead><tr><th>序号</th><th>工程号</th><th>船名</th><th>分段名</th><th>任务开始</th><th>切割时长</th><th>电耗（{{ report.units.electricity }}）</th><th>气耗（{{ report.units.gas }}）</th></tr></thead>
      <tbody>{% for row in report.equipment_records %}<tr><td>{{ loop.index }}</td><td>{{ task_label(row.project_code) }}</td><td>{{ task_label(row.ship_no) }}</td><td>{{ task_label(row.segment_name) }}</td><td>{{ row.production_time|chinese_datetime }}</td><td>{{ row.work_time|duration }}</td><td>{{ row.electricity_consumption|number }}</td><td>{{ row.gas_consumption|number }}</td></tr>{% endfor %}</tbody>
      <tfoot><tr><th colspan="5">汇总</th><th>{{ report.equipment_summary.total_work_time|duration }}</th><th>{{ report.equipment_summary.total_electricity_consumption|number }}</th><th>{{ report.equipment_summary.total_gas_consumption|number }}</th></tr></tfoot></table>
      {% else %}<div class="empty">所选区间暂无任务。</div>{% endif %}
      </div>
    </div>

    {{ section_title('近 12 个月月度能耗汇总' if report.meta.custom_period else '月度每日能耗汇总') }}
    <div class="data-chart-grid">
      <div id="equipment-month-chart" class="chart"></div>
      <div class="table-wrap">
        <table class="screen-only"><thead><tr><th>序号</th><th>{{ '月份' if report.meta.custom_period else '日期' }}</th><th>任务数</th><th>切割时长</th><th>电耗（{{ report.units.electricity }}）</th><th>气耗（{{ report.units.gas }}）</th></tr></thead>
        <tbody>{% for row in report.energy_month.rows %}<tr><td>{{ loop.index }}</td><td>{{ row.report_date|chinese_date }}</td><td>{{ '--' if row.is_future else row.task_count or 0 }}</td><td>{{ '--' if row.is_future else row.work_time_seconds|duration }}</td><td>{{ row.electricity.value|number }}</td><td>{{ row.gas.value|number }}</td></tr>{% endfor %}</tbody>
        <tfoot><tr><th></th><th>汇总</th><th>{{ report.energy_month.total_task_count }}</th><th>{{ report.energy_month.total_work_time_seconds|duration }}</th><th>{{ report.energy_month.summary.electricity.value|number }}</th><th>{{ report.energy_month.summary.gas.value|number }}</th></tr></tfoot></table>
        </div>
    </div>
    {% endif %}

  </section>
  {% if analysis or report.data_quality %}{{ render_analysis(analysis, report, report.meta.period_start, report.meta.period_end, summary_shown) }}{% endif %}
  <p class="lp-end">报告结束<span>{{ report.meta.report_id }}</span></p>
</div>
{% endif %}
<script>{{ echarts_source|safe }}</script>
<script>
  const charts = [];
  {% if report.meta.report_type == 'leadership' %}
  const prepareLeadershipCharts = () => {
    const render = (id, option, monthly) => {
      const element = document.getElementById(id);
      if (!element || echarts.getInstanceByDom(element)) return;
      option.animation = false;
      option.backgroundColor = 'transparent';
      option.textStyle = { ...option.textStyle, color: '#385480', fontSize: 10 };
      option.grid = { left: 48, right: 44, top: 45, bottom: 28 };
      option.legend = { ...option.legend, top: 5, itemWidth: 13, itemHeight: 8, textStyle: { fontSize: 9, color: '#405a80' } };
      const axes = Array.isArray(option.yAxis) ? option.yAxis : [option.yAxis];
      axes.forEach(axis => { axis.nameTextStyle = { fontSize: 9, color: '#405a80' }; axis.axisLabel = { ...axis.axisLabel, fontSize: 9 }; });
      option.xAxis.axisLabel = { ...option.xAxis.axisLabel, fontSize: 8, hideOverlap: true };
      option.series.forEach((series, index) => {
        const color = ['#0869c5', monthly ? '#00aaa5' : '#8a6aea', monthly ? '#005bff' : '#f39b00'][index % 3];
        series.itemStyle = { ...series.itemStyle, color };
        if (series.type === 'line') series.lineStyle = { ...series.lineStyle, color, width: 2 };
      });
      const chart = echarts.init(element, null, { renderer: 'svg' });
      chart.setOption(option); charts.push(chart);
    };
    {% if report.leadership.daily_records %}render('lp-daily-chart', {{ report.charts.daily_trend|tojson }}, false);{% endif %}
    {% if report.leadership.monthly_records %}render('lp-monthly-chart', {{ report.charts.monthly_trend|tojson }}, true);{% endif %}
  };
  prepareLeadershipCharts();
  {% elif report.meta.report_type == 'workshop' and report.summary.task_count %}
  const lengthChart = echarts.init(document.getElementById('length-chart'));
  lengthChart.setOption({{ report.charts.length_combo|tojson }}); charts.push(lengthChart);
  {% elif report.meta.report_type == 'equipment' %}
  {% if report.equipment_records %}
  const equipmentDetailChart = echarts.init(document.getElementById('equipment-detail-chart'));
  equipmentDetailChart.setOption({{ report.charts.equipment_detail|tojson }}); charts.push(equipmentDetailChart);
  {% endif %}
  const equipmentMonthChart = echarts.init(document.getElementById('equipment-month-chart'));
  equipmentMonthChart.setOption({{ report.charts.equipment_month|tojson }}); charts.push(equipmentMonthChart);
  {% endif %}
  const resizeCharts = () => charts.forEach(chart => chart.resize());
  const preparePrint = () => {
    document.documentElement.classList.add('report-printing');
    {% if report.meta.report_type == 'leadership' %}prepareLeadershipCharts();{% endif %}
    void document.body.offsetWidth;
    charts.forEach(chart => {
      chart.resize();
      chart.setOption({ animation: false }, false);
    });
  };
  const restoreScreen = () => {
    document.documentElement.classList.remove('report-printing');
    requestAnimationFrame(resizeCharts);
  };
  window.addEventListener('resize', resizeCharts);
  window.addEventListener('beforeprint', preparePrint);
  window.addEventListener('afterprint', restoreScreen);
  const printMedia = window.matchMedia('print');
  if (printMedia.addEventListener) printMedia.addEventListener('change', event => {
    if (event.matches) preparePrint();
    else restoreScreen();
  });
  charts.forEach(chart => chart.setOption({ animation: false }, false));
  Promise.resolve(document.fonts?.ready).then(() => requestAnimationFrame(() => requestAnimationFrame(() => {
    resizeCharts();
    document.documentElement.dataset.reportReady = 'true';
    window.__REPORT_READY__ = true;
  })));
</script>
{% include "industrial_report.js.j2" %}
</body>
</html>
