APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
APP_VERSION=0.1.0
APP_DEMO_MODE=true
# 可选：demo / excel / sqlserver；设置后优先于 APP_DEMO_MODE
APP_DATA_SOURCE_MODE=demo
TASK_EXCEL_PATH=TASK.xlsx
APP_CORS_ORIGINS=http://localhost:5173
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false

# Docker 端口映射。正式环境建议保持 127.0.0.1，由 Nginx/IIS 提供 HTTPS。
DOCKER_BIND_ADDRESS=127.0.0.1
DOCKER_PORT=8000

SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
SQLSERVER_CONNECT_TIMEOUT_SECONDS=5
SQLSERVER_QUERY_TIMEOUT_SECONDS=120
# 首页和领导报表按月份共享查询结果；设为 0 可关闭缓存。
LEADERSHIP_REPORT_CACHE_SECONDS=300
# 设备日报、智能分析和最新生产日期共享按日查询结果；设为 0 可关闭缓存。
REPORT_DATA_CACHE_SECONDS=300

# 工人登录库：从 dbo.HRbase_userInfo 按“公司工号 + 密码”验证。
# 正式环境应填写这套独立连接；全部留空时仅为兼容旧部署回退到 SQLSERVER_*。
WORKER_SQLSERVER_HOST=
WORKER_SQLSERVER_PORT=1433
WORKER_SQLSERVER_DATABASE=
WORKER_SQLSERVER_USERNAME=
WORKER_SQLSERVER_PASSWORD=
WORKER_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
WORKER_SQLSERVER_ENCRYPT=yes
WORKER_SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
WORKER_SQLSERVER_CONNECT_TIMEOUT_SECONDS=5
WORKER_SQLSERVER_QUERY_TIMEOUT_SECONDS=15
# 外网开发时保持 false；部署到可访问内网数据库的服务器后改为 true。
WORKER_DATABASE_AUTH_ENABLED=false
# HR 表中“可用”和“_Locked”字段允许登录时的实际值。
WORKER_DATABASE_AVAILABLE_VALUE=1
WORKER_DATABASE_UNLOCKED_VALUE=0

# 切割文件库：PDM 文件索引/内容使用独立只读账号。
# 表和字段映射确认、下载接口接入前保持 false。
FILE_DATABASE_ENABLED=false
FILE_SQLSERVER_HOST=
FILE_SQLSERVER_PORT=1433
FILE_SQLSERVER_DATABASE=
FILE_SQLSERVER_USERNAME=
FILE_SQLSERVER_PASSWORD=
FILE_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
FILE_SQLSERVER_ENCRYPT=yes
FILE_SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
FILE_SQLSERVER_CONNECT_TIMEOUT_SECONDS=5
FILE_SQLSERVER_QUERY_TIMEOUT_SECONDS=15

LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

REPORT_MAX_DETAIL_ROWS=1000
CHART_TOP_N=20
REPORT_WORKER_POLL_SECONDS=0.5

# 报表自动化与邮件发送。SMTP_ENABLED=false 时仍会保留发送失败记录。
AUTOMATION_ENABLED=true
AUTOMATION_SCAN_SECONDS=15
EMAIL_RETRY_BASE_SECONDS=60
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=切割生产智能产报系统
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# SQL 工作台默认关闭。仅在已启用管理员保护和 HTTPS 的环境中开启。
SQL_WORKBENCH_ENABLED=false
SQL_WORKBENCH_ADMIN_TOKEN=
SQL_WORKBENCH_MAX_ROWS=200

# 管理员在“设置 → 数据库配置”保存的参数会写入 data/settings.env，
# 并在下次启动时覆盖本文件中对应的数据库配置。
