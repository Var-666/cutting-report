# 配置优先级（高到低）：data/settings.env > 进程环境变量 > 本文件 > 程序默认值。
# 管理页面写入 data/settings.env，不是独立配置来源；产线实例只取 PRODUCTION_LINES_JSON，连接只取 DATABASE_SOURCES_JSON。
# 产线、数据源连接与自动化/SMTP 管理保存后跨进程热加载；资源容量及其余启动参数修改后重启 Web 与 Worker。
# Docker 修改宿主机 .env 后需 docker compose up -d --force-recreate app worker。
# 在“系统设置 → 配置诊断”核对两进程的实际快照、来源及待重启/异常状态。

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
APP_VERSION=0.1.0
# P4 独立状态库工具；正式 Web/Worker 仍使用 SQLite，不加入 DATABASE_SOURCES_JSON。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=cutting_report
POSTGRES_USER=cutting_migrator
POSTGRES_PASSWORD=
POSTGRES_POOL_MIN_SIZE=0
POSTGRES_POOL_MAX_SIZE=4
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
# 仅 PostgreSQL profile 首次初始化使用；三种角色使用不同私有密码。
POSTGRES_BOOTSTRAP_PASSWORD=
POSTGRES_APP_PASSWORD=
APP_DEMO_MODE=true
# 可选：demo / sqlserver；设置后优先于 APP_DEMO_MODE
APP_DATA_SOURCE_MODE=demo
APP_CORS_ORIGINS=http://localhost:5173
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false

# Docker 端口映射。正式环境建议保持 127.0.0.1，由 Nginx/IIS 提供 HTTPS。
DOCKER_BIND_ADDRESS=127.0.0.1
DOCKER_PORT=8088

# 唯一产线及连接配置。旧部署先停 Web/Worker，再运行 scripts/migrate_production_lines.py。
# 此处为新安装的演示配置；现场连接由数据库页保存，不把凭据提交到 Git。
PRODUCTION_LINES_JSON='{"schema_version":2,"lines":[{"id":"Cutter01","name":"20KW切割机","type":"cutting","source_key":"cutting-production","enabled":true,"device_id":"Cutter01","production_line_id":"Cutter01","machine_no":"Cutter01","energy":{"equipment_ids":["Cutter01"],"gas_parameter_id":"bd3179be-c587-f011-a2e9-000c2974f33c","electricity_parameter_ids":["2b00e015-d987-f011-a2e9-000c2974f33c","98cbd135-d987-f011-a2e9-000c2974f33c","93fae152-d987-f011-a2e9-000c2974f33c"]},"alarm":{"start_at":"2026-09-29 00:00:00"}},{"id":"Cutter02","name":"30KW切割机","type":"cutting","source_key":"cutting-production","enabled":true,"device_id":"Cutter02","production_line_id":"Cutter02","machine_no":"Cutter02","energy":null,"alarm":{"start_at":"2026-10-12 00:00:00"}},{"id":"welding","name":"小组立焊接线","type":"welding","source_key":"welding-production","enabled":false}],"default_line_id":"Cutter01"}'
DATABASE_SOURCES_JSON='[{"id":"cutting-production","name":"切割生产库","engine":"sqlserver","enabled":false,"host":"","port":1433,"database":"","username":"","password":""},{"id":"welding-production","name":"焊接生产库","engine":"mysql","enabled":false,"host":"","port":3306,"database":"weld_production_data","username":"","password":""}]'
WORKER_SOURCE_KEY=cutting-production
FILE_SOURCE_KEY=cutting-production
DISPATCH_SOURCE_KEY=cutting-production
# SQL 配额由同机 Web/Worker 共享；以下容量及单源 sql_max_concurrent 修改后同时重启两个进程。
SQL_GLOBAL_MAX_CONCURRENT=12
SQL_GLOBAL_MAX_WAITERS=32
SQL_QUEUE_TIMEOUT_SECONDS=5
SQLSERVER_DEFAULT_MAX_CONCURRENT=6
MYSQL_DEFAULT_MAX_CONCURRENT=4
SQL_LINE_MAX_CONCURRENT=2
# HTTP 执行池独立于 SQL；快照、模型和 PDF 请求各自排队。
HTTP_QUERY_MAX_CONCURRENT=12
HTTP_SNAPSHOT_MAX_CONCURRENT=4
HTTP_ANALYSIS_MAX_CONCURRENT=10
HTTP_PDF_MAX_CONCURRENT=2
HTTP_AUTH_MAX_CONCURRENT=8
HTTP_MAX_WAITERS=32
# 当前月领导报表刷新间隔；页面优先读取应用 SQLite 快照。
LEADERSHIP_REPORT_CACHE_SECONDS=600
# 历史月快照有效期；最近三个月每天校准，其他月份在查询且过期时更新。
LEADERSHIP_REPORT_HISTORY_CACHE_SECONDS=86400
# 每天从该小时开始校准最近三个月，取值 0-23。
LEADERSHIP_REPORT_RECONCILE_HOUR=2
# 设备日报、智能分析和最新生产日期共享按日查询结果；设为 0 可关闭缓存。
REPORT_DATA_CACHE_SECONDS=600
# 当前周期领导、车间、设备及焊接报表每 5 分钟后台刷新；切割有模型配置时每轮强制分析，数据未变也重新分析。
# 此项写入 data/settings.env 后按新操作热加载，实际间隔最少 30 秒；修改 .env 仍须重建/重启进程。
REPORT_BACKGROUND_REFRESH_SECONDS=300
# 能管平台（仅查询，不写入采集值）。正式环境需在内网完成登录联调后启用。
# demo 模式始终显示明确标识的演示能耗；sqlserver 未接通时显示缺失。
ENERGY_API_ENABLED=false
ENERGY_API_BASE_URL=http://10.147.0.38:10091
ENERGY_API_USERNAME=
ENERGY_API_PASSWORD=
ENERGY_API_TIMEOUT_SECONDS=10
ENERGY_CACHE_SECONDS=60
# 设备机号、别名及仪表绑定请维护在PRODUCTION_LINES_JSON，以下旧变量不再作为覆盖配置。
# 多个值只允许同一物理设备的历史别名，不能把这套仪表绑定给多台物理设备。
# 累计气量，用户已确认输出单位为 Nm³。
# ENERGY_GAS_PARAMETER_ID=bd3179be-c587-f011-a2e9-000c2974f33c
ENERGY_GAS_UNIT=Nm³
# 只填经确认需要相加的正向有功电能参数编号（逗号分隔，不能总表+分表重复相加）。
# DH01: 2b00e015-d987-f011-a2e9-000c2974f33c
# DH02: 98cbd135-d987-f011-a2e9-000c2974f33c
# DH03: 93fae152-d987-f011-a2e9-000c2974f33c
# 电耗使用正常用电单位：kWh（1 kWh = 1 度电）。
ENERGY_ELECTRICITY_UNIT=kWh
# 接口 Mv 已经乘过读数因子，默认 1，不再重复乘 CT/PT 倍率。
ENERGY_GAS_FACTOR=1
ENERGY_ELECTRICITY_FACTOR=1
# 非采样时刻的边界插值会标为估算；超过最大间隔不计算。
ENERGY_ALLOW_INTERPOLATION=true
ENERGY_MAX_GAP_SECONDS=300
# 按已确认的切换日启用一分钟采样规则；留空可关闭，沿用全部历史阈值。
# 无时区的时间按 APP_TIMEZONE 解释；跨切换时间的采样分别校验两侧间隔。
ENERGY_SAMPLING_CHANGE_AT=2026-09-04T00:00:00+08:00
ENERGY_NEW_MAX_GAP_SECONDS=180

# 统一设备能耗报表：当前 DH01/DH02/DH03 只属于 Cutter01。
# 多个值仅允许填写 Cutter01 的历史别名，不能把 Cutter02 加入同一仪表组。
# ENERGY_REPORT_EQUIPMENT_IDS=Cutter01
# 页面第一张表按任务实际起止时间计算，第二张表读取已保存的逐日总耗量。
# ENERGY_REPORT_ELECTRICITY_PARAMETER_IDS=2b00e015-d987-f011-a2e9-000c2974f33c,98cbd135-d987-f011-a2e9-000c2974f33c,93fae152-d987-f011-a2e9-000c2974f33c
# 统一任务/日/月报的历史阈值；切换时间之后改用 ENERGY_NEW_MAX_GAP_SECONDS。
ENERGY_REPORT_MAX_GAP_SECONDS=1800
# 历史日记录普通查询的更新间隔；今日最多缓存60秒，手动更新绕过缓存。
ENERGY_REPORT_SNAPSHOT_TTL_SECONDS=3600
# 统一设备报表的电耗单位为 kWh（度）。

# 工人登录库：从 dbo.HRbase_userInfo 按“公司工号 + 密码”验证。
# 连接通过 WORKER_SOURCE_KEY 绑定 Registry，不继承其他连接。
# 外网开发时保持 false；部署到可访问内网数据库的服务器后改为 true。
WORKER_DATABASE_AUTH_ENABLED=false
# HR 表中“可用”字段允许登录时的实际值；不校验 _Locked。
WORKER_DATABASE_AVAILABLE_VALUE=1
# HR 会话读取复核间隔；写操作每次复核，HR 不可用时拒绝本次请求
WORKER_DATABASE_SESSION_CHECK_SECONDS=60

# 切割文件库：PDM 文件索引/内容使用独立只读账号。
# 表和字段映射确认、下载接口接入前保持 false。
FILE_DATABASE_ENABLED=false
# PDM状态值需在内网联调后按正式约定调整。
FILE_STATUS_SENT_VALUE=已派发
FILE_STATUS_FAILED_VALUE=派发失败

# 文件来源：disabled / http / mock / local。http 调用 FO 文件下载接口。
# 外网和未联调环境必须保持 disabled；mock 只用于显式联调。
FILE_SOURCE_MODE=disabled
FILE_SOURCE_LOCAL_ROOT=
FILE_HTTP_BASE_URL=http://10.147.0.17:8800
# 可选：文件服务自己的认证头。未要求认证时留空，不使用能管平台授权码。
FILE_HTTP_AUTHORIZATION=
FILE_HTTP_COOKIE=
FILE_DOWNLOAD_TIMEOUT_SECONDS=60
# 默认单文件最多50MiB；成功文件保留7天，记录保留至统一派发保留期。设为0可关闭实体文件自动清理。
FILE_DOWNLOAD_MAX_BYTES=52428800
FILE_DOWNLOAD_RETENTION_DAYS=7
FILE_SERVER_HOST=10.147.0.33
FILE_SERVER_PHYSICAL_ROOT=D:\File

# 魔盒地址、Token、Secret和机床IP从生产库 dbo.SYS_CONFIG 白名单读取。
# 开启后仍需管理员在“文件推送”页明确确认，系统不会按查询条件批量推送。
MAGIC_BOX_ENABLED=false
MAGIC_BOX_TIMEOUT_SECONDS=60
# 一次上传/指派/取消流程共享的魔盒总预算
MAGIC_BOX_OPERATION_TIMEOUT_SECONDS=180
MAGIC_BOX_CONFIG_CACHE_SECONDS=60

LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# LLM 单次完整 HTTP 响应时限（包含响应体读取），连接超时最多10秒；仅429最多重试两次
LLM_TIMEOUT_SECONDS=180
LLM_MAX_INPUT_CHARS=500000
LLM_MAX_OUTPUT_CHARS=50000
# 定时报表可使用全局容量；告警等其他后台任务最多使用一半并发，前台等待时优先放行前台
LLM_MAX_CONCURRENT=10
LLM_QUEUE_TIMEOUT_SECONDS=120

# 智能告警：按目录中的每台设备和各自起点独立采集；同一持续问题只生成一份PDF。
# 确认生产库可访问且已配置LLM后再启用。
ALARM_MONITOR_ENABLED=false
ALARM_MONITOR_INTERVAL_SECONDS=300
# ALARM_MONITOR_MACHINE_NOS=Cutter01
# ALARM_MONITOR_START_AT=2026-09-29 00:00:00
ALARM_REOPEN_DEBOUNCE_MINUTES=10
ALARM_MONITOR_BATCH_SIZE=500

# 运行数据统一保留策略；单项设为0可关闭该类清理。
# 仅清理已完成报告和车间任务快照、已关闭告警、非活动派发和过期审计，不删除运行中数据。
REPORT_RETENTION_DAYS=365
ANALYSIS_RETENTION_DAYS=90
# 告警发生超过30天且已解除时清理记录及关联告警报告，未解除的不删。
ALARM_RETENTION_DAYS=30
DISPATCH_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
RETENTION_CLEANUP_INTERVAL_HOURS=24
# 单批最多500，避免超过SQLite参数数量并限制单次事务时长。
RETENTION_CLEANUP_BATCH_SIZE=500

REPORT_MAX_DETAIL_ROWS=1000
CHART_TOP_N=20
REPORT_WORKER_POLL_SECONDS=0.5
# 工作线程长时间没有推进时健康接口降级；按实际最大任务耗时配置
REPORT_WORKER_STALL_TIMEOUT_SECONDS=900
# 单份后台报表所有查询、分析和渲染阶段共用的总预算
REPORT_OPERATION_TIMEOUT_SECONDS=900
# PDF 渲染使用独立 Chromium 进程；超时后父进程终止子进程并清理临时文件
PDF_RENDER_TIMEOUT_SECONDS=120

# 报表自动化与邮件发送。SMTP_ENABLED=false 时仍会保留发送失败记录。
AUTOMATION_ENABLED=true
AUTOMATION_SCAN_SECONDS=15
EMAIL_RETRY_BASE_SECONDS=60
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=切割生产智能产报系统
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# SQL 工作台默认关闭。仅在已启用管理员保护和 HTTPS 的环境中开启。
SQL_WORKBENCH_ENABLED=false
SQL_WORKBENCH_ADMIN_TOKEN=
SQL_WORKBENCH_MAX_ROWS=200

# 焊接实例在 PRODUCTION_LINES_JSON 中配置 enabled/timezone/source_key/device_nos。
# MySQL 连接及 pool_size/connect_timeout/query_timeout 均在 DATABASE_SOURCES_JSON 中按源配置并热加载。

# 管理员在“设置 → 数据库配置”保存的参数会写入 data/settings.env，
# 覆盖本文件及进程环境变量中对应的数据库配置，新请求/任务热加载。
# 自动化/SMTP 由下一轮操作加载；诊断接口本身不会触发加载。
