APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
APP_VERSION=0.1.0
APP_DEMO_MODE=true
# 可选：demo / excel / sqlserver；设置后优先于 APP_DEMO_MODE
APP_DATA_SOURCE_MODE=demo
TASK_EXCEL_PATH=TASK.xlsx
APP_CORS_ORIGINS=http://localhost:5173
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false

# Docker 端口映射。正式环境建议保持 127.0.0.1，由 Nginx/IIS 提供 HTTPS。
DOCKER_BIND_ADDRESS=127.0.0.1
DOCKER_PORT=8000

SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
SQLSERVER_CONNECT_TIMEOUT_SECONDS=5
SQLSERVER_QUERY_TIMEOUT_SECONDS=120
# 首页和领导报表按月份共享查询结果；设为 0 可关闭缓存。
LEADERSHIP_REPORT_CACHE_SECONDS=300
# 设备日报、智能分析和最新生产日期共享按日查询结果；设为 0 可关闭缓存。
REPORT_DATA_CACHE_SECONDS=300

# 能管平台（仅查询，不写入采集值）。正式环境需在内网完成登录联调后启用。
# demo 模式始终显示明确标识的演示能耗；excel/sqlserver 未接通时显示缺失。
ENERGY_API_ENABLED=false
ENERGY_API_BASE_URL=http://10.147.0.38:10091
ENERGY_API_USERNAME=
ENERGY_API_PASSWORD=
ENERGY_API_TIMEOUT_SECONDS=10
ENERGY_CACHE_SECONDS=60
# 必填：2万瓦激光切割机在 dbo.task.MACHINE_NO 中的编号，不可猜测 Cutter01/Cutter02。
# 多个值只允许同一物理设备的历史别名，不能把这套仪表绑定给多台物理设备。
ENERGY_EQUIPMENT_IDS=
# 累计气量，用户已确认输出单位为 Nm³。
ENERGY_GAS_PARAMETER_ID=bd3179be-c587-f011-a2e9-000c2974f33c
ENERGY_GAS_UNIT=Nm³
# 只填经确认需要相加的正向有功电能参数编号（逗号分隔，不能总表+分表重复相加）。
# DH01: 2b00e015-d987-f011-a2e9-000c2974f33c
# DH02: 98cbd135-d987-f011-a2e9-000c2974f33c
# DH03: 93fae152-d987-f011-a2e9-000c2974f33c
ENERGY_ELECTRICITY_PARAMETER_IDS=
# 电耗使用正常用电单位：kWh（1 kWh = 1 度电）。
ENERGY_ELECTRICITY_UNIT=kWh
# 接口 Mv 已经乘过读数因子，默认 1，不再重复乘 CT/PT 倍率。
ENERGY_GAS_FACTOR=1
ENERGY_ELECTRICITY_FACTOR=1
# 非采样时刻的边界插值会标为估算；超过最大间隔不计算。
ENERGY_ALLOW_INTERPOLATION=true
ENERGY_MAX_GAP_SECONDS=300
# 按已确认的切换日启用一分钟采样规则；留空可关闭，沿用全部历史阈值。
# 无时区的时间按 APP_TIMEZONE 解释；跨切换时间的采样分别校验两侧间隔。
ENERGY_SAMPLING_CHANGE_AT=2026-09-04T00:00:00+08:00
ENERGY_NEW_MAX_GAP_SECONDS=180

# 统一设备能耗报表：当前 DH01/DH02/DH03 只属于 Cutter01。
# 多个值仅允许填写 Cutter01 的历史别名，不能把 Cutter02 加入同一仪表组。
ENERGY_REPORT_EQUIPMENT_IDS=Cutter01
# 页面第一张表按任务实际起止时间计算，第二张表读取已保存的逐日总耗量。
ENERGY_REPORT_ELECTRICITY_PARAMETER_IDS=2b00e015-d987-f011-a2e9-000c2974f33c,98cbd135-d987-f011-a2e9-000c2974f33c,93fae152-d987-f011-a2e9-000c2974f33c
# 统一任务/日/月报的历史阈值；切换时间之后改用 ENERGY_NEW_MAX_GAP_SECONDS。
ENERGY_REPORT_MAX_GAP_SECONDS=1800
# 历史日记录普通查询的更新间隔；今日最多缓存60秒，手动更新绕过缓存。
ENERGY_REPORT_SNAPSHOT_TTL_SECONDS=3600
# 统一设备报表的电耗单位为 kWh（度）。

# 工人登录库：从 dbo.HRbase_userInfo 按“公司工号 + 密码”验证。
# 正式环境应填写这套独立连接；全部留空时仅为兼容旧部署回退到 SQLSERVER_*。
WORKER_SQLSERVER_HOST=
WORKER_SQLSERVER_PORT=1433
WORKER_SQLSERVER_DATABASE=
WORKER_SQLSERVER_USERNAME=
WORKER_SQLSERVER_PASSWORD=
WORKER_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
WORKER_SQLSERVER_ENCRYPT=yes
WORKER_SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
WORKER_SQLSERVER_CONNECT_TIMEOUT_SECONDS=5
WORKER_SQLSERVER_QUERY_TIMEOUT_SECONDS=15
# 外网开发时保持 false；部署到可访问内网数据库的服务器后改为 true。
WORKER_DATABASE_AUTH_ENABLED=false
# HR 表中“可用”字段允许登录时的实际值；不校验 _Locked。
WORKER_DATABASE_AVAILABLE_VALUE=1

# 切割文件库：PDM 文件索引/内容使用独立只读账号。
# 表和字段映射确认、下载接口接入前保持 false。
FILE_DATABASE_ENABLED=false
FILE_SQLSERVER_HOST=
FILE_SQLSERVER_PORT=1433
FILE_SQLSERVER_DATABASE=
FILE_SQLSERVER_USERNAME=
FILE_SQLSERVER_PASSWORD=
FILE_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
FILE_SQLSERVER_ENCRYPT=yes
FILE_SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
FILE_SQLSERVER_CONNECT_TIMEOUT_SECONDS=5
FILE_SQLSERVER_QUERY_TIMEOUT_SECONDS=15
# PDM状态值需在内网联调后按正式约定调整。
FILE_STATUS_SENT_VALUE=已派发
FILE_STATUS_FAILED_VALUE=派发失败

# 文件来源：disabled / http / mock / local。http 调用 FO 文件下载接口。
# 外网和未联调环境必须保持 disabled；mock 只用于显式联调。
FILE_SOURCE_MODE=disabled
FILE_SOURCE_LOCAL_ROOT=
FILE_HTTP_BASE_URL=http://10.147.0.17:8800
# 可选：文件服务自己的认证头。未要求认证时留空，不使用能管平台授权码。
FILE_HTTP_AUTHORIZATION=
FILE_HTTP_COOKIE=
FILE_DOWNLOAD_TIMEOUT_SECONDS=60
# 默认单文件最多50MiB；文件和记录保存到 data 卷，不会在升级时清空。
FILE_DOWNLOAD_MAX_BYTES=52428800
FILE_SERVER_HOST=10.147.0.33
FILE_SERVER_PHYSICAL_ROOT=D:\File

# 魔盒地址、Token、Secret和机床IP从生产库 dbo.SYS_CONFIG 白名单读取。
# 开启后仍需管理员在“文件推送”页明确确认，系统不会按查询条件批量推送。
MAGIC_BOX_ENABLED=false
MAGIC_BOX_TIMEOUT_SECONDS=60
MAGIC_BOX_CONFIG_CACHE_SECONDS=60

LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# 智能告警：每5分钟只读取20kw切割机；同一持续问题只生成一份PDF。
# 确认生产库可访问且已配置LLM后再启用。
ALARM_MONITOR_ENABLED=false
ALARM_MONITOR_INTERVAL_SECONDS=300
ALARM_MONITOR_MACHINE_NOS=20kw切割机
ALARM_REOPEN_DEBOUNCE_MINUTES=10
ALARM_MONITOR_BATCH_SIZE=500

REPORT_MAX_DETAIL_ROWS=1000
CHART_TOP_N=20
REPORT_WORKER_POLL_SECONDS=0.5

# 报表自动化与邮件发送。SMTP_ENABLED=false 时仍会保留发送失败记录。
AUTOMATION_ENABLED=true
AUTOMATION_SCAN_SECONDS=15
EMAIL_RETRY_BASE_SECONDS=60
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=切割生产智能产报系统
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# SQL 工作台默认关闭。仅在已启用管理员保护和 HTTPS 的环境中开启。
SQL_WORKBENCH_ENABLED=false
SQL_WORKBENCH_ADMIN_TOKEN=
SQL_WORKBENCH_MAX_ROWS=200

# 管理员在“设置 → 数据库配置”保存的参数会写入 data/settings.env，
# 并在下次启动时覆盖本文件中对应的数据库配置。
