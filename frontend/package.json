{
  "name": "cutting-report-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "sync:echarts": "node scripts/sync-echarts.mjs",
    "preview": "vite preview",
    "lint": "eslint src vite.config.ts uno.config.ts vitest.config.ts",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "pnpm run typecheck && pnpm test && pnpm run build:bundle",
    "build:bundle": "pnpm run sync:echarts && vite build && node scripts/copy-notices.mjs"
  },
  "dependencies": {
    "@iconify-icons/line-md": "^2.0.0",
    "@iconify-icons/material-symbols": "^2.0.6",
    "@iconify-icons/mdi": "^2.0.0",
    "@iconify-icons/ph": "^2.0.0",
    "@iconify/vue": "^5.0.3",
    "@vueuse/core": "^15.0.0",
    "clipboard": "^2.0.11",
    "colord": "^2.10.0",
    "defu": "^6.1.7",
    "echarts": "^5.6.0",
    "klona": "2.0.6",
    "naive-ui": "2.45.3",
    "pinia": "3.0.4",
    "simplebar-vue": "^2.4.2",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.13",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@css-render/vue3-ssr": "0.15.14",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^20.19.43",
    "@unocss/core": "66.6.0",
    "@unocss/preset-mini": "66.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "2.4.6",
    "eslint": "^10.15.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.26",
    "pyright": "^1.1.414",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "unocss": "66.6.0",
    "vite": "^5.4.14",
    "vitest": "3.2.7",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
